# Complete Microsoft catalog example. One stanza owns the shared tenant,
# credential, schedule, and state while Api="all" expands to every catalog
# dataset and routes them through the 22 consolidated ms-* destination tags.

[Global]
Label="Microsoft Hosted Runner 1.0.0"
Ingester-UUID="11111111-1111-4111-8111-111111111111" # Synthetic example: replace with a unique persistent UUID
# Ingest-Secret="REPLACE_ME"
# Ingest-Secret-File="/opt/gravwell/secrets/gravwell-ingest.secret"
# Cleartext-Backend-Target="127.0.0.1:4023"
# Encrypted-Backend-Target="127.0.0.1:4024"
# Pipe-Backend-Target="/opt/gravwell/comms/pipe"
Connection-Timeout=0
Enable-Compression=false
Insecure-Skip-TLS-Verify=false
# Ingest-Cache-Path="/opt/gravwell/cache/hosted_runner.cache"
# Max-Ingest-Cache=1024
# Cache-Depth=256
# Cache-Mode="fail"
# Log-Level="INFO"
# Log-File="/opt/gravwell/log/hosted_runner.log"

[State]
Path="/opt/gravwell/state/hosted_runner.state"
Sync=false

[Microsoft "complete-catalog"]
# Synthetic example identifiers: replace them with this deployment's values.
Tenant-ID="22222222-2222-4222-8222-222222222222"
Client-ID="33333333-3333-4333-8333-333333333333"
Client-Secret="REPLACE_WITH_CLIENT_SECRET_VALUE"
# Vendor tenant UUID required by the Management Activity API. This is not the
# customer tenant, application, or object UUID.
Publisher-Identifier="44444444-4444-4444-8444-444444444444"
Graph-Host="https://graph.microsoft.com"
ARM-Host="https://management.azure.com"
Defender-Host="https://api.securitycenter.microsoft.com"
Defender-XDR-Host="https://api.security.microsoft.com"
PowerBI-Host="https://api.powerbi.com"
Management-Host="https://manage.office.com"
Auth-Host="https://login.microsoftonline.com"
Subscription-ID="55555555-5555-4555-8555-555555555555"
Api="all"
Lookback=24
Requests-Per-Minute=10
Request-Interval=3600
# Ingester-UUID is optional; omission uses the plugin's stable default UUID.
# Tag-Name is omitted so every dataset uses its consolidated ms-* destination.
